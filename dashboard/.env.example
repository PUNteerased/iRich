# Local dashboard → API directly
NEXT_PUBLIC_TELEMETRY_URL=http://127.0.0.1:8000

# Vercel (Settings → Environment Variables):
#   TELEMETRY_UPSTREAM=https://YOUR-SUBDOMAIN.ngrok-free.app
#   NEXT_PUBLIC_TELEMETRY_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# Browser on Vercel uses same-origin /api/bridge (no CORS).
# TELEMETRY_UPSTREAM is the server-side upstream (preferred).
